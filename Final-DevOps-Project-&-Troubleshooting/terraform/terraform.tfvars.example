# Copy to terraform.tfvars and change the values. Do not commit terraform.tfvars if it has private data.
# This file has no credentials. Terraform reads AWS credentials from the environment or the AWS CLI config.
project_name         = "taskboard"
environment          = "dev"
aws_region           = "ap-south-1"
vpc_cidr             = "10.21.0.0/16"
public_subnet_cidrs  = ["10.21.0.0/24", "10.21.1.0/24"]
private_subnet_cidrs = ["10.21.10.0/24", "10.21.11.0/24"]
kubernetes_version   = "1.33"
node_instance_types  = ["t3.medium"]
node_desired_size    = 2
node_min_size        = 2
node_max_size        = 4
eks_public_endpoint  = false
admin_cidr           = "203.0.113.10/32"
backup_retention_days = 30
